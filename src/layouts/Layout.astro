---
import "@/styles/global.css";
interface Props {
  title?: string;
}
const { title = "Videasy Lite — Movie Search & Watch" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Search movies and series, get details, stream instantly. Simple, fast, no account."
    />
    <!--
      KUR-21 left this page with `upgrade-insecure-requests`, but that directive
      also upgrades the page's own CSS/JS when the app is opened over plain
      http:// on the LAN (KUR-24: broken styling). The official player switch
      (commit 0ec3a7b) already serves everything over https, so the directive is
      no longer needed here — do not re-add it.
    -->
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-zinc-950 text-zinc-100 antialiased">
    <header class="border-b border-zinc-800/60">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <a href="/" class="text-lg font-bold tracking-tight">videasy<span class="text-purple-500">.lite</span></a>
        <span class="text-xs text-zinc-500">no account · no tracking</span>
      </div>
    </header>
    <slot />
    <footer class="border-t border-zinc-800/60 py-6 text-center text-xs text-zinc-600">
      Metadata: Cinemeta (Stremio) · Player: videasy (player.videasy.net)
    </footer>
  </body>
</html>
