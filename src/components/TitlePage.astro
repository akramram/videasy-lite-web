---
// Detail page (movie or series) — KUR-25. Rendered by /title/[id] (movies)
// and /tv/[id] (series). Series with episodes get a season <select> (multi
// season only) + episode buttons wired by src/scripts/detail.ts; multi-season
// pages SSR only the ?s=N season's episodes (default season 1).
import Layout from "@/layouts/Layout.astro";
import { WatchPanel } from "@/islands";
import { parseYear, posterUrl, tmdbId } from "@/lib/cinemeta";
import type { Detail } from "@/lib/cinemeta";
import type { EmbedTarget } from "@/lib/videasy";

interface Props {
  id: string;
  type: "movie" | "series";
  detail: Detail;
  /** ?s=N season param resolved by /tv/[id] (series only, default 1). */
  season?: number;
}

const { id, type, detail, season = 1 } = Astro.props;

const videos = [...(detail.videos ?? [])].sort(
  (a, b) => a.season - b.season || a.number - b.number,
);
const seasons = [...new Set(videos.map((v) => v.season))].sort((a, b) => a - b);
const isSeries = type === "series" && seasons.length > 0;
const isMultiSeason = isSeries && seasons.length > 1;
// ?s=N wins when it names a real season; otherwise the first that exists.
const activeSeason =
  isMultiSeason && seasons.includes(season) ? season : (seasons[0] ?? 1);
// US-1 deep link: Continue-watching cards emit ?s=N&ep=SE{S}E{E}. ?s renders
// the season list; ?ep (when it matches the rendered season) pins the exact
// resume episode as the default embed target.
const epMatch = /^S(\d+)E(\d+)$/.exec(Astro.url.searchParams.get("ep") ?? "");
const resumeEpisode =
  epMatch && Number(epMatch[1]) === activeSeason
    ? { season: Number(epMatch[1]), episode: Number(epMatch[2]) }
    : null;
const episodes = isSeries ? videos.filter((v) => v.season === activeSeason) : [];

const year = parseYear(detail.releaseInfo);
// Player prefers the TMDB id; IMDB id is a verified fallback (KUR-21).
const target: EmbedTarget =
  type === "movie"
    ? { type: "movie", id: tmdbId(detail) ?? id }
    : {
        type: "tv",
        id: tmdbId(detail) ?? id,
        season: resumeEpisode?.season ?? activeSeason,
        episode: resumeEpisode?.episode ?? 1,
      };

const backdrop = `https://images.metahub.space/background/medium/${detail.id}/img`;
const poster = detail.poster ?? posterUrl(detail.id);

// US-2 deep link: /title/{id}?play=1 (poster hover "Play now") mounts the
// player on load. US-1: ?progress=<sec> resumes at the stored position.
const playParam = Astro.url.searchParams.get("play");
const progressParam = Astro.url.searchParams.get("progress");
const autoPlay = playParam === "1";
const startSeconds =
  progressParam && /^\d+$/.test(progressParam) ? Number(progressParam) : undefined;

// US-1 hero CTA label: Resume when a fresh cw.v1 entry exists, else Play.
const ctaSeason = target.type === "tv" ? target.season : undefined;
const ctaEpisode = target.type === "tv" ? target.episode : undefined;

// US-1 continue-watching context for the player relay (Amendment 1): the
// PLAYER_EVENT listener needs the page's canonical identity — IMDB id (store
// key), TMDB id (embed id), human title, runtime minutes (wall-clock fallback
// cap). runtime parses "92 min" -> 92; absent on some records.
const runtimeMatch = /^(\d+)\s*min$/.exec(detail.runtime ?? "");
const cwContext = {
  imdbId: detail.id,
  tmdbId: target.id,
  type: type === "movie" ? ("movie" as const) : ("tv" as const),
  title: detail.name,
  runtimeMin: runtimeMatch ? Number(runtimeMatch[1]) : undefined,
  // US-4: active-season episodes for the next-episode chip (titles + last-
  // episode detection). Whole series passed; Player filters to activeEp.
  episodes: isSeries
    ? videos.map((v) => ({ season: v.season, number: v.number, name: v.name }))
    : [],
};
---

<Layout title={`${detail.name} — Videasy Lite`}>
  <main class="pb-16">
    <section class="relative">
      <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
        <img
          src={backdrop}
          alt=""
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover opacity-25"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/70 to-zinc-950/40"></div>
      </div>

      <div class="relative mx-auto flex max-w-6xl flex-col gap-6 px-4 pt-10 sm:flex-row">
        <img
          src={poster}
          alt={detail.name}
          loading="eager"
          decoding="async"
          width="270"
          height="400"
          class="w-36 shrink-0 self-start rounded-[var(--radius-card)] border border-zinc-800/70 object-cover shadow-[var(--shadow-player)] ring-1 ring-white/10 sm:w-44"
        />
        <div class="flex min-w-0 flex-col justify-end gap-3">
          <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{detail.name}</h1>
          <ul class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-zinc-400">
            <li class="rounded border border-zinc-700 px-1.5 py-0.5 text-xs font-medium uppercase tracking-wide text-zinc-300">
              {type === "movie" ? "Movie" : "Series"}
            </li>
            {year && <li class="tabular-nums">{year}</li>}
            {
              detail.imdbRating && (
                <li class="flex items-center gap-1 tabular-nums">
                  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 text-amber-400" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l2.9 6.26 6.86.6-5.2 4.51 1.56 6.7L12 16.55 5.88 20.07l1.56-6.7-5.2-4.51 6.86-.6L12 2z" />
                  </svg>
                  {detail.imdbRating}
                </li>
              )
            }
            {detail.runtime && <li class="tabular-nums">{detail.runtime}</li>}
          </ul>
          {
            detail.genres && detail.genres.length > 0 && (
              <ul class="flex flex-wrap gap-2">
                {detail.genres.map((genre) => (
                  <li class="rounded-full border border-zinc-800 bg-zinc-900/70 px-3 py-1 text-xs text-zinc-300">
                    {genre}
                  </li>
                ))}
              </ul>
            )
          }
          {
            detail.description && (
              <p class="max-w-3xl text-sm leading-relaxed text-zinc-400">
                {detail.description}
              </p>
            )
          }
          <!-- US-2 CTA row: full-width on mobile (always in first viewport),
               auto width on desktop. Click deep-links ?play=1 which auto-mounts
               the player; label becomes Resume when cw.v1 has fresh progress. -->
          <div class="mt-1 flex flex-wrap items-center gap-3">
            <a
              id="hero-play"
              href={`?play=1${startSeconds ? `&progress=${startSeconds}` : ""}`}
              data-cw-resume-target={detail.id}
              data-cw-resume-type={type === "movie" ? "movie" : "tv"}
              data-cw-resume-tmdb={target.id}
              data-cw-resume-name={detail.name}
              data-cw-resume-season={ctaSeason}
              data-cw-resume-episode={ctaEpisode}
              data-sticky-src="hero"
              class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-[var(--radius-control)] bg-purple-600 px-6 font-medium text-white outline-none motion-fast hover:bg-purple-500 focus-visible:ring-2 focus-visible:ring-purple-500 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950 active:scale-[0.98] w-full sm:w-auto"
              aria-label={`Play ${detail.name}`}
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
                <path d="M8 5.14v13.72L19 12 8 5.14Z" />
              </svg>
              <span id="hero-play-label">
                {type === "movie" ? "Play movie" : `Play S${target.season}E${target.episode}`}
              </span>
            </a>
            <a
              href="/"
              class="inline-flex min-h-[44px] items-center rounded-[var(--radius-control)] px-3 text-sm text-zinc-400 outline-none motion-fast hover:text-zinc-200 focus-visible:ring-2 focus-visible:ring-purple-500"
            >
              Back to search
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- US-5 sticky mini-header (KUR-49.2 §4-B): 56px fixed bar that appears
         once the hero CTA scrolls out — restores path-to-play from deep in
         the episode list (A6). Synced from #hero-play by stickyHeader.ts
         (label/href incl. Resume rewrite); <noscript> fallback keeps Play. -->
    <div
      id="sticky-header"
      class="fixed inset-x-0 top-0 z-50 hidden h-14 border-b border-zinc-800/70 bg-zinc-950/70 backdrop-blur motion-base"
      data-sticky-state="hidden"
    >
      <div class="mx-auto flex h-full max-w-6xl items-center gap-3 px-4">
        <span class="sticky-thumb h-8 w-8 shrink-0 overflow-hidden rounded-[var(--radius-still)] bg-zinc-800" aria-hidden="true">
          <img src={poster} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
        </span>
        <span class="sticky-title min-w-0 flex-1 truncate text-sm font-semibold text-zinc-100">
          {detail.name}
        </span>
        <a
          id="sticky-play"
          href={`?play=1${startSeconds ? `&progress=${startSeconds}` : ""}`}
          class="inline-flex min-h-[44px] shrink-0 items-center gap-1.5 rounded-[var(--radius-control)] bg-purple-600 px-4 text-sm font-medium text-white outline-none motion-fast hover:bg-purple-500 focus-visible:ring-2 focus-visible:ring-purple-500"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M8 5.14v13.72L19 12 8 5.14Z" />
          </svg>
          <span id="sticky-play-label">Play</span>
        </a>
      </div>
    </div>

    <section class="mx-auto mt-8 flex max-w-6xl flex-col gap-6 px-4">
      <div data-title-id={detail.id} class="contents">
        <WatchPanel
          client:load
          target={target}
          title={detail.name}
          backHref="/"
          autoPlay={autoPlay}
          startSeconds={startSeconds}
          cw={cwContext}
        />
      </div>

      {
        isSeries && (
          <div class="flex flex-col gap-4">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-400">
                {isMultiSeason ? `Season ${activeSeason} episodes` : "Episodes"}
              </h2>
              {isMultiSeason && (
                <label class="flex items-center gap-2 text-sm text-zinc-400">
                  Season
                  <select
                    id="season-select"
                    class="min-h-[44px] rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-2 text-sm text-zinc-100 focus:border-purple-500 focus:outline-none"
                  >
                    {seasons.map((s) => (
                      <option value={String(s)} selected={s === activeSeason}>
                        {s === 0 ? "Specials" : `Season ${s}`}
                      </option>
                    ))}
                  </select>
                </label>
              )}
            </div>

            <ul id="episode-list" class="grid grid-cols-1 gap-2 sm:grid-cols-2">
              {
                episodes.map((episode) => (
                  <li>
                    <button
                      type="button"
                      class="episode-btn flex w-full gap-3 rounded-lg border border-zinc-800/70 bg-zinc-900/50 p-2 text-left transition hover:border-purple-500/80 hover:bg-zinc-900"
                      data-season={String(episode.season)}
                      data-episode={String(episode.number)}
                      data-title={episode.name}
                    >
                      <span
                        class="relative block w-24 shrink-0 overflow-hidden rounded-[var(--radius-still)] bg-zinc-800/60"
                        style="aspect-ratio: 16 / 9"
                        aria-hidden="true"
                      >
                        {episode.thumbnail ? (
                          <img
                            src={episode.thumbnail}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-cover"
                          />
                        ) : (
                          <span class="flex h-full w-full items-center justify-center text-lg font-bold text-zinc-600">
                            {episode.number}
                          </span>
                        )}
                        <!-- Watched check (US-4 §4-C): revealed by detail.ts
                             when a cw.v1/watched.v1 entry covers this episode. -->
                        <span class="ep-watched-check absolute inset-0 hidden items-center justify-center bg-zinc-950/60">
                          <svg viewBox="0 0 24 24" class="h-6 w-6 text-amber-400" fill="currentColor" aria-hidden="true">
                            <path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                          </svg>
                        </span>
                      </span>
                      <span class="flex min-w-0 flex-col">
                        <span class="flex items-baseline gap-2">
                          <span class="ep-num shrink-0 text-sm font-semibold tabular-nums text-purple-400">
                            E{episode.number}
                          </span>
                          <span class="min-w-0 truncate text-sm text-zinc-200">
                            {episode.name || `Episode ${episode.number}`}
                          </span>
                        </span>
                        {episode.overview && (
                          <span class="mt-1 line-clamp-2 block text-xs leading-relaxed text-zinc-400">
                            {episode.overview}
                          </span>
                        )}
                      </span>
                    </button>
                  </li>
                ))
              }
            </ul>
          </div>
        )
      }
    </section>
  </main>

  <!-- Episode/season wiring (plain DOM, see src/scripts/detail.ts). -->
  <script>
    import "@/scripts/detail";
    import "@/scripts/backdrop";
    import "@/scripts/nextUnwatched";
    import "@/scripts/cwResumeLabel";
    import "@/scripts/stickyHeader";
  </script>
</Layout>
